# Copy to .env and paste ONE provider key.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: pin the model as provider/model. auto() picks from the key otherwise.
# CAVE_MODEL=anthropic/claude-sonnet-5

# What the local `npm run investigate` is allowed to do. `read` inspects
# traces; `write_resource` may also activate an evaluator. Everything else
# is denied before it executes.
INVESTIGATOR_GRANT=read

# Only for `npm run serve`: a bearer secret of 16+ characters.
CAVE_SERVE_TOKEN=replace-with-a-real-secret-please
