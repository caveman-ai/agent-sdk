# Copy to .env and paste ONE provider key. Nothing else is required.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Model as provider/model from the public catalog. auto() would pick
# claude-haiku-4-5 for an Anthropic key, but Haiku 4.5 only caches prefixes of
# 4,096+ tokens and this agent's static prefix is smaller than that, so the
# warm-read economics the demo is about would never show. Sonnet caches from
# 1,024 tokens.
CAVE_MODEL=anthropic/claude-sonnet-5

# Only for `npm run serve`: a bearer secret of 16+ characters. The endpoint
# spends money, so there is no unauthenticated mode.
CAVE_SERVE_TOKEN=replace-with-a-real-secret-please
