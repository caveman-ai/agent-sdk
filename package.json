{
  "name": "caveman-agent-sdk-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source monorepo for Caveman Agent SDK, adapters, protocol, coding agent, and initializer.",
  "license": "Apache-2.0",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/agent",
    "packages/adapter-kit",
    "packages/adapter-conformance",
    "packages/adapters/*",
    "packages/coding-agent",
    "packages/create-caveman-agent",
    "packages/evals",
    "packages/react",
    "packages/pebble-protocol"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run build:protocol && npm run build:evals && npm run build:agent && npm run build:create-agent",
    "build:agent": "npm --prefix packages/agent run build",
    "build:create-agent": "npm --prefix packages/create-caveman-agent run build",
    "build:evals": "npm --prefix packages/evals run build",
    "build:protocol": "npm --prefix packages/pebble-protocol run build",
    "check:catalog": "node scripts/generate-agent-catalog.mjs --check",
    "docs:api": "node scripts/generate-docs-api.mjs",
    "license:check": "node scripts/license-lint.mjs",
    "test": "npm run license:check && npm run check:size && npm run check:catalog && npm run test:repo && npm run test:protocol && npm run test:evals && npm run test:react && npm run test:adapter-kit && npm run test:adapter-conformance && npm run test:coding-agent && npm run test:package-types && npm run test:agent && npm run check:api && npm run test:adapters && npm run test:conformance-candidates && npm run test:create-agent && npm run test:example",
    "test:repo": "node --test scripts/tests/*.test.mjs",
    "test:protocol": "npm --prefix packages/pebble-protocol test",
    "test:adapter-kit": "node --test packages/adapter-kit/tests/*.test.mjs",
    "test:adapters": "npm run test --workspace=packages/adapters --if-present",
    "test:adapter-conformance": "node --test packages/adapter-conformance/tests/*.test.mjs",
    "test:conformance-candidates": "node packages/adapter-conformance/candidates/run-candidates.mjs --check",
    "test:coding-agent": "node --test packages/coding-agent/tests/*.test.mjs",
    "test:evals": "npm --prefix packages/evals test",
    "test:package-types": "node scripts/typecheck-packages.mjs",
    "test:agent": "npm --prefix packages/agent test",
    "test:create-agent": "npm --prefix packages/create-caveman-agent test",
    "test:example": "node scripts/test-examples.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "test:react": "node --test packages/react/tests/*.test.mjs",
    "check:size": "node scripts/size-budget.mjs",
    "check:api": "npm run build:agent && node scripts/api-surface.mjs",
    "api:update": "npm run build:agent && node scripts/api-surface.mjs --update",
    "check:drift": "node scripts/upstream-drift.mjs"
  }
}
