{
  "name": "@caveman-ai/agent",
  "version": "1.0.0",
  "description": "Build, evaluate, and run efficient AI agents locally (in-process on Harness v4) or on Caveman Cloud.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caveman-ai/agent-sdk.git",
    "directory": "packages/agent"
  },
  "homepage": "https://docs.caveman.so",
  "bugs": {
    "url": "https://github.com/caveman-ai/agent-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@caveman-ai/harness": "workspace:^",
    "@caveman-ai/protocol": "workspace:^",
    "@caveman-ai/sdk": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "25.9.8",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts"
  }
}
