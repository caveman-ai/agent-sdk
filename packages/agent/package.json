{
  "name": "@caveman-ai/agent",
  "version": "0.2.0",
  "description": "Profile-guided compiler and build system for portable, eval-gated production agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuliusBrussee/agent-sdk.git",
    "directory": "packages/agent"
  },
  "homepage": "https://caveman.so/products/caveman-agent",
  "bugs": {
    "url": "https://github.com/JuliusBrussee/agent-sdk/issues"
  },
  "type": "module",
  "keywords": [
    "agents",
    "ai",
    "compiler",
    "evals",
    "llm",
    "opentelemetry",
    "optimization"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "caveman-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "import": "./dist/code.js"
    },
    "./command-session": {
      "types": "./dist/command-session.d.ts",
      "import": "./dist/command-session.js"
    },
    "./execution-backend": {
      "types": "./dist/execution-backend.d.ts",
      "import": "./dist/execution-backend.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./programmatic-tools": {
      "types": "./dist/programmatic-tools.d.ts",
      "import": "./dist/programmatic-tools.js"
    },
    "./connect": {
      "types": "./dist/connect.d.ts",
      "import": "./dist/connect.js"
    },
    "./plugins": {
      "types": "./dist/agent-environment.d.ts",
      "import": "./dist/agent-environment.js"
    },
    "./compaction": {
      "types": "./dist/compaction-api.d.ts",
      "import": "./dist/compaction-api.js"
    },
    "./memory": {
      "types": "./dist/memory-api.d.ts",
      "import": "./dist/memory-api.js"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "import": "./dist/durable.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js"
    },
    "./serve-handler": {
      "types": "./dist/serve-handler.d.ts",
      "import": "./dist/serve-handler.js"
    },
    "./model-boundary": {
      "types": "./dist/model-boundary.d.ts",
      "import": "./dist/model-boundary.js"
    },
    "./model-usage": {
      "types": "./dist/model-usage.d.ts",
      "import": "./dist/model-usage.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./run-receipt": {
      "types": "./dist/run-receipt.d.ts",
      "import": "./dist/run-receipt.js"
    },
    "./cache-engine": {
      "types": "./dist/cache-planner/index.d.ts",
      "import": "./dist/cache-planner/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "docs",
    "hosting"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "lint": "tsc --noEmit",
    "test": "tsc && tsc --project tsconfig.test.json && node --test tests/programmatic-tools.test.ts && node --test tests/*.runtime.mjs",
    "test:types": "tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@caveman-ai/adapter-kit": "0.1.0",
    "@caveman-ai/evals": "0.1.0",
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@pebble-agent/protocol": "0.1.0",
    "@standard-schema/spec": "1.1.0",
    "es-module-lexer": "2.3.2",
    "typebox": "1.3.7",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@types/node": "24.10.1",
    "ajv": "8.20.0",
    "eve": "0.29.2",
    "pg": "^8.23.0",
    "typescript": "5.9.3",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
