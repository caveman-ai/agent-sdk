{
  "name": "@caveman-ai/adapter-vercel-ai-sdk",
  "version": "0.1.0",
  "description": "Native Caveman middleware and lifecycle adapter for Vercel AI SDK.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuliusBrussee/agent-sdk.git",
    "directory": "packages/adapters/vercel-ai-sdk"
  },
  "type": "module",
  "main": "src/index.js",
