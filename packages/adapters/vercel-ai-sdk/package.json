    "@types/json-schema": "7.0.15",
    "@types/node": "26.4.1",
    "ai": "7.0.84",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=22.19.0" },
  "publishConfig": { "access": "public" }
}
