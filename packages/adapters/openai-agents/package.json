{
  "name": "@caveman-ai/adapter-openai-agents",
  "version": "0.1.0",
  "description": "Native Caveman model-boundary adapter for OpenAI Agents SDK.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuliusBrussee/agent-sdk.git",
    "directory": "packages/adapters/openai-agents"
  },
  "homepage": "https://caveman.so/products/caveman-agent",
  "bugs": {
    "url": "https://github.com/JuliusBrussee/agent-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "agents",
    "ai",
    "openai",
    "observability",
    "middleware"
  ],
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./manifest": {
      "types": "./src/manifest.d.ts",
      "import": "./src/manifest.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run test:runtime && npm run test:types",
    "test:runtime": "node --test tests/*.test.mjs",
    "test:types": "tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@caveman-ai/adapter-kit": "0.1.0"
  },
  "peerDependencies": {
    "@caveman-ai/agent": "0.2.0",
    "@openai/agents": "0.17.0",
    "@openai/agents-core": "0.17.0"
  },
  "devDependencies": {
    "@openai/agents": "0.17.0",
    "@openai/agents-core": "0.17.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "zod": "4.5.4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
