{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caveman.so/schemas/eval-dataset.schema.json",
  "title": "Caveman evaluation dataset",
  "description": "Canonical dataset snapshot used by an evaluation workbench run.",
  "type": "object",
  "required": ["schema_version", "columns", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/column" }
    },
    "rows": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
    },
    "column": {
      "type": "object",
      "required": ["key", "name", "type", "role"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "enum": ["string", "number", "boolean", "json", "image_url", "messages"] },
        "role": { "enum": ["input", "expected", "metadata", "output"] }
      }
    },
    "row": {
      "type": "object",
      "required": ["row_key", "values"],
      "additionalProperties": false,
      "properties": {
        "row_key": { "$ref": "#/$defs/key" },
        "values": { "type": "object" },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "uniqueItems": true
        }
      }
    }
  }
}
