{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caveman.so/schemas/agent-trajectory.schema.json",
  "title": "Caveman Normalized Agent Trajectory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trajectory_sha256",
    "case_sha256",
    "lineage_sha256",
    "run_sha256",
    "agent_sha256",
    "input_sha256",
    "source",
    "split",
    "provider",
    "model",
    "terminal",
    "outcome",
    "usage_basis",
    "price_basis",
    "input_tokens",
    "output_tokens",
    "cache_read_tokens",
    "cache_write_tokens",
    "reasoning_tokens",
    "cost_usd",
    "latency_ms",
    "model_calls",
    "context_bill",
    "tools",
    "evaluated_transform_ids",
    "applied_transform_ids",
    "recovery_resolved"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trajectory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "case_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "lineage_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "agent_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source": {
      "enum": ["caveman_run_result", "otel_span", "openinference_span"]
    },
    "split": {
      "enum": ["profile", "development", "holdout"]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "terminal": {
      "type": "boolean"
    },
    "outcome": {
      "enum": ["complete", "stopped", "error"]
    },
    "usage_basis": {
      "enum": ["provider_reported", "unavailable"]
    },
    "price_basis": {
      "enum": ["public_catalog", "unpriced"]
    },
    "input_tokens": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "output_tokens": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "cache_read_tokens": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "cache_write_tokens": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "reasoning_tokens": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "model_calls": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "context_bill": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "instruction",
          "user_intent",
          "tool_schema",
          "skill",
          "memory",
          "history",
          "tool_result",
          "artifact",
          "error",
          "output_contract"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonNegativeInteger"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toolActivity"
      }
    },
    "evaluated_transform_ids": {
      "$ref": "#/$defs/stringSet"
    },
    "applied_transform_ids": {
      "$ref": "#/$defs/stringSet"
    },
    "recovery_resolved": {
      "type": "boolean"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "toolActivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_sha256", "effect", "calls", "errors"],
      "properties": {
        "tool_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "effect": {
          "enum": ["read", "idempotent", "write", "external"]
        },
        "calls": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "errors": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
