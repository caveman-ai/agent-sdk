{
  "name": "@caveman-ai/protocol",
  "version": "1.0.0",
  "description": "Open Session Protocol, AGENT.md build manifest schemas, and eval file contracts for Caveman agents.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caveman-ai/agent-sdk.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://docs.caveman.so",
  "bugs": {
    "url": "https://github.com/caveman-ai/agent-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
