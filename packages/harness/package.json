{
  "name": "@caveman-ai/harness",
  "version": "1.0.0",
  "private": false,
  "description": "The Caveman Harness (v4): open-source, loadout-driven, cache-stable agent loop with LocalEnv, DockerEnv, and SandboxEnv.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "caveman-harness": "./dist/harness.mjs"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "prepack": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/bundle.mjs && node --experimental-strip-types --no-warnings --test tests/*.test.ts"
  },
  "files": [
    "dist/harness.mjs",
    "dist/harness.mjs.sha256",
    "dist/lib.mjs",
    "dist/lib.d.ts",
    "dist/testing.mjs",
    "dist/testing.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@caveman-ai/sdk": "file:../../../cloud-sdk/packages/sdk-ts",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "typebox": "1.3.27",
    "@earendil-works/pi-mcp": "1.4.0",
    "quickjs-wasi": "3.6.2",
    "esbuild": "0.28.2"
  },
  "libVersion": "1.0.0",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caveman-ai/agent-sdk.git",
    "directory": "packages/harness"
  },
  "homepage": "https://docs.caveman.so",
  "bugs": {
    "url": "https://github.com/caveman-ai/agent-sdk/issues"
  }
}
